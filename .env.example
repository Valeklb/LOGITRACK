# =====================================================================
# Backend (Railway)
# =====================================================================
PORT=3000

# Caminho do banco SQLite. No Railway, crie um Volume em /data ANTES e use:
#   DATABASE_PATH=/data/logistic.db
# Sem volume, cada deploy apaga todos os dados.
DATABASE_PATH=logistic.db

# Conta de administrador criada só quando o banco está vazio.
# No primeiro acesso o sistema obriga a trocar a senha.
# Padrão (se não definir): admin@logitrack.com / admin123
# ADMIN_EMAIL=admin@suaempresa.com.br
# ADMIN_PASSWORD=uma-senha-provisoria

# Opcional: cria um gestor e/ou um motorista na inicialização, se ainda não
# existir usuário com esse e-mail. A senha é provisória (mín. 6 caracteres)
# e precisa ser trocada no primeiro acesso.
# GESTOR_NAME=Nome do Gestor
# GESTOR_EMAIL=gestor@suaempresa.com.br
# GESTOR_TEMP_PASSWORD=senha-provisoria
# MOTORISTA_NAME=Nome do Motorista
# MOTORISTA_EMAIL=motorista@suaempresa.com.br
# MOTORISTA_TEMP_PASSWORD=senha-provisoria

# =====================================================================
# Frontend (Vercel)
# =====================================================================
# URL pública da API no Railway, com https:// e sem barra no final.
# Obrigatória: sem ela o build na Vercel falha de propósito.
RAILWAY_API_URL=https://sua-api.up.railway.app

# WebSocket (avisos em tempo real). Se vazio, usa a mesma URL da API.
VITE_WS_URL=https://sua-api.up.railway.app

# Alternativa a RAILWAY_API_URL (mesmo efeito):
# VITE_API_URL=https://sua-api.up.railway.app
